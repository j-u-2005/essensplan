{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "essensplan",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "essensplan",
      "database_id": "22f7ed9c-7de8-4301-824c-00e913c1fc66"
    }
  ],
  "observability": { "enabled": true }
}
